<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
       Only exists on Android 13+ and is inert below it. Declaring it is required for
       the runtime request to be possible at all; MainActivity gates the actual
       request on API 33+, so nothing is ever asked on Android 12 or lower.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
       allowBackup="false" already disables backup on every supported API level, which
       is why no fullBackupContent companion file exists for API 24-30. The extraction
       rules are still needed because Android 12+ treats device-to-device transfer as a
       separate channel that allowBackup does not cover.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TechnoRoofing">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.TechnoRoofing"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".AppMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
           Used by the FCM SDK for notifications it draws itself while the app is
           backgrounded. Without the channel id those land on a system fallback
           channel the user cannot meaningfully manage.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
    </application>

</manifest>
